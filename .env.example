# ─────────────────────────────────────────────────────────────
# Sumam's Boutique — environment template
#
# Copy to `.env.local` for local dev, or paste into your host's env UI
# for production. Never commit a real `.env` file.
#
# Variables marked [PUBLIC] are sent to the browser — never put a secret there.
# Variables marked [SECRET] must stay server-side only.
# ─────────────────────────────────────────────────────────────

# ── Supabase (database, auth, storage) ──────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co        # [PUBLIC]
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key                      # [PUBLIC]
SUPABASE_SERVICE_ROLE_KEY=                                       # [SECRET] server-only: payments, webhooks. NEVER NEXT_PUBLIC.

# ── Razorpay (India checkout) ───────────────────────────────
# Dashboard → Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=                                     # [PUBLIC] opens checkout in the browser
RAZORPAY_KEY_ID=                                                 # [SECRET]
RAZORPAY_KEY_SECRET=                                             # [SECRET] can issue refunds

# Dashboard → Settings → Webhooks → add:
#   https://www.sumamsboutique.com/api/razorpay/webhook
# Copy the signing secret here. Webhook returns 500 without it.
RAZORPAY_WEBHOOK_SECRET=                                         # [SECRET]

# ── Resend (transactional email) ────────────────────────────
# Verify the sending domain in Resend first, then create a key.
RESEND_API_KEY=                                                  # [SECRET]
EMAIL_FROM=Sumam's Boutique <orders@sumamsboutique.com>          # [PUBLIC] must be a verified domain

# ── App ─────────────────────────────────────────────────────
# Public site origin — used for canonical URLs, sitemap and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000                       # [PUBLIC]

# ── Analytics (optional) ────────────────────────────────────
# Google Analytics 4 measurement ID. Leave empty to disable tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=                                   # [PUBLIC]
