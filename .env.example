NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Razorpay (India checkout)
# NEXT_PUBLIC_RAZORPAY_KEY_ID is public — used by the client to open checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay dashboard → x-razorpay-signature verification.
RAZORPAY_WEBHOOK_SECRET=

# Supabase service-role key — server-only (payments, webhooks). NEVER NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 (gtag). Leave empty to disable tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend transactional email (order confirmations). Leave empty to disable emails.
RESEND_API_KEY=
EMAIL_FROM=Sumam's Boutique <orders@sumamsboutique.com>

# Stripe (international checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo customer account shown as hint on the login page. The matching user must
# exist in Supabase (Auth + profiles with role 'customer'). Falls back to
# demo@sumamsboutique.com / customer123 if unset.
NEXT_PUBLIC_DEMO_CUSTOMER_EMAIL=
NEXT_PUBLIC_DEMO_CUSTOMER_PASSWORD=
